# PlatformIO build output and resolved dependencies
.pio/
.pioenvs/
.piolibdeps/
# SCons's derived-file cache, when PLATFORMIO_BUILD_CACHE_DIR points here (CI does)
.pio-build-cache/

# Secrets are never committed. secrets.h.example documents every field.
secrets.h

.DS_Store

# Personal per-machine Claude Code settings. Project-wide settings, if any,
# belong in .claude/settings.json, which is committed.
.claude/settings.local.json

# Python bytecode, from tools/rangetest/test_capture.py importing capture.py
__pycache__/
*.pyc
