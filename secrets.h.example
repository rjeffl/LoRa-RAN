//
// TEMPLATE. Copy to `secrets.h`, fill in real values, and never commit that copy.
// See LRAN-Bridge_Node-Implementation-Plan v0.4 section 11.4.
//
//     cp secrets.h.example secrets.h
//
// `secrets.h` is gitignored; this file is committed and is the documentation for
// what a fresh clone needs. Every field below is required: a missing one fails the
// build with a message rather than producing a node that cannot authenticate for
// reasons nobody can see.

#pragma once

// ---------------------------------------------------------------------------
// Protocol master key - spec 9.1
// ---------------------------------------------------------------------------
//
// 32 bytes. Only the BRIDGE holds this; each node is flashed with only its own
// derived key (node_key = HKDF-SHA256(master, salt "lran-v1", info "node-"||id)).
//
// Generate one with:
//
//     openssl rand -hex 32 | sed 's/../0x&, /g'
//
// NEVER commit, echo, log or paste this value. A leak means re-provisioning every
// node, which for GateLink is a USB reflash at the gate.
#define LRAN_MASTER_KEY { \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }

// ---------------------------------------------------------------------------
// WiFi - bridge only. Nodes have no WiFi.
// ---------------------------------------------------------------------------
#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// ---------------------------------------------------------------------------
// MQTT broker
// ---------------------------------------------------------------------------
//
// The broker address lives here rather than in a source file so switching between
// the dev Mosquitto and production is a rebuild, not a diff that could be committed
// by accident (section 11.3).
#define MQTT_HOST     "192.168.1.10"
#define MQTT_PORT     1883
#define MQTT_USER     "lran-bridge"
#define MQTT_PASSWORD "your-mqtt-password"

// ---------------------------------------------------------------------------
// OTA - bridge only. Remote nodes have NO OTA by design; a node firmware change
// is a USB reflash in the field.
// ---------------------------------------------------------------------------
#define OTA_PASSWORD "your-ota-password"

// ---------------------------------------------------------------------------
// Completeness check. A field added to this template but missing from someone's
// existing secrets.h fails here, loudly, at build time.
// ---------------------------------------------------------------------------
#if !defined(LRAN_MASTER_KEY)
#error "secrets.h: LRAN_MASTER_KEY missing - see secrets.h.example"
#endif
#if !defined(WIFI_SSID) || !defined(WIFI_PASSWORD)
#error "secrets.h: WiFi credentials missing - see secrets.h.example"
#endif
#if !defined(MQTT_HOST) || !defined(MQTT_PORT) || !defined(MQTT_USER) || \
    !defined(MQTT_PASSWORD)
#error "secrets.h: MQTT settings missing - see secrets.h.example"
#endif
#if !defined(OTA_PASSWORD)
#error "secrets.h: OTA_PASSWORD missing - see secrets.h.example"
#endif
