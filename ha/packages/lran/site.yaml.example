#
# The per-install half of the LRAN package (HA Integration Implementation Plan 6). Copy it
# to site.yaml beside core.yaml and fill it in. site.yaml is not committed, because it
# names the operator's phone and mail account. Every other file in packages/lran/ is the
# same on every install.
#
# HA loads every *.yaml in this directory as a package, and this file's .example suffix
# keeps it out until it is renamed.

script:
  # Every push to the admin goes through here. core.yaml's lran_notify builds `data`: the
  # tag, the actions and the critical or time-sensitive options. Add one action per phone.
  lran_site_push:
    alias: LRAN site push
    mode: parallel
    fields:
      title: { selector: { text: } }
      message: { selector: { text: } }
      data: { selector: { object: } }
    sequence:
      - action: notify.mobile_app_YOUR_PHONE
        data:
          title: "{{ title }}"
          message: "{{ message }}"
          data: "{{ data }}"

  # Every email to the admin goes through here, and only while
  # input_boolean.lran_email_enabled is on (plan 7.3).
  lran_site_email:
    alias: LRAN site email
    mode: parallel
    fields:
      title: { selector: { text: } }
      message: { selector: { text: } }
    sequence:
      - action: notify.send_message
        target:
          entity_id: notify.lran_email_YOU
        data:
          title: "{{ title }}"
          message: "{{ message }}"

  # The same, to input_text.lran_additional_emails rather than the admin (plan 7.3).
  # `recipients` is a list of SMTP recipient entities, and each gets its own email.
  lran_site_email_to:
    alias: LRAN site email to additional recipients
    mode: parallel
    fields:
      recipients: { selector: { object: } }
      title: { selector: { text: } }
      message: { selector: { text: } }
    sequence:
      - action: notify.send_message
        target:
          entity_id: "{{ recipients }}"
        data:
          title: "{{ title }}"
          message: "{{ message }}"

# SMTP is set up in the UI, under Settings > Devices & services, not here. Each address is a
# recipient on that integration, and each recipient is a notify entity. HA 2026.10's source
# marks the older `notify.<name>` action as breaking in 2027.3: with no target it mails every
# recipient, which would send the admin's health alerts to everyone (plan 7.3).

# Install-wide, so it lives here rather than in core.yaml (plan 10). Every install needs
# this exclusion: the raw mV sensors already hold the history of the V copies.
recorder:
  exclude:
    entity_globs:
      - sensor.lran_gatelink_*_voltage_v
    entities:
      - sensor.gatelink_last_seen
      - sensor.gatelink_bms_reading_age
      - sensor.lran_gatelink_crossing_log
  # 30 days, if the database has room, so the Events logbook reaches back a month.
  purge_keep_days: 30
